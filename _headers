# ═══════════════════════════════════════════════════════════════════
# CACHING RULES FOR CLOUDFLARE PAGES.
#
# READ THIS BEFORE CHANGING ANY OF IT.
#
# Measured, from the two hosts side by side:
#
#   arizonarabbitry.pages.dev/rabbits.js   max-age=0, must-revalidate
#   arizonarabbits.com/rabbits.js          max-age=14400
#
# Pages sends the right thing. The ZONE rewrites it. Cloudflare's
# Browser Cache TTL sits at its 4 hour default, and by its own rules
# it overrides the origin whenever the origin asks for LESS. So this
# file cannot win on its own, and the setting has to change too:
#
#   dash.cloudflare.com > arizonarabbits.com > Caching >
#   Configuration > Browser Cache TTL > "Respect Existing Headers"
#
# Until that is done, availability can be up to four hours stale in a
# returning visitor's browser. Two rabbits were marked reserved and
# the site kept showing them as available, which is how this was
# found.
#
# WHY THE SPLIT BELOW.
# A stale photograph is a mild problem: you see yesterday's picture of
# the right rabbit. Stale availability is a severe one: somebody asks
# about a rabbit that is already spoken for, and the site looks either
# careless or dishonest. So the two are cached completely differently.
#
# max-age=0 does NOT mean downloading it again every time. The ETag
# still stands, so an unchanged file answers 304 with no body. One
# small round trip, and availability is never wrong.
# ═══════════════════════════════════════════════════════════════════

# THE ONE FILE THAT MUST NEVER BE STALE. Every price, status and
# countdown on the site is read from it.
/rabbits.js
  Cache-Control: public, max-age=0, must-revalidate

# Carries what is available and what has been placed. Served at /litters (the
# .html address redirects there), so the rule names both (2 Oct 2026).
/litters
  Cache-Control: public, max-age=0, must-revalidate
/litters.html
  Cache-Control: public, max-age=0, must-revalidate

# Pictures, cached for a day rather than forever ON PURPOSE. Photos on
# this site DO get replaced under the same filename: every "Coming
# soon" frame becomes a real photograph eventually. Cache one of those
# for a year and the placeholder outlives the real picture.
# If you replace a photo and want it seen immediately, give the new
# file a new name and point rabbits.js at it. That is instant, and it
# costs nothing.
/photos/*
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=86400
# Clips, the same rule as pictures (7 Sept 2026): cached for a day, and a
# replaced clip gets a NEW filename in rabbits.js. Range requests are what a
# player uses to seek; Pages answers them by itself.
/videos/*
  Cache-Control: public, max-age=86400
# Fonts (3 Oct 2026, fontsself.py): named by their own fingerprint, so a font
# that changes is a new file; these can be kept a year and never asked again.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# EVERY PAGE (3 Oct 2026, a technical audit): never framed by another site,
# content types taken as sent, and HTTPS remembered for a year. No full CSP:
# the pages carry their own inline script and style by design. What a CSP can
# still close without touching them (the same day, the second audit): no
# plugins, no <base> rewriting every link, forms post only here and to
# Formspree (the three forms' action, used when script is off), and no page
# may ask for the camera, the microphone or where you are, none of which the
# site ever uses.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'none'; form-action 'self' https://formspree.io
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000

# WILLIAM'S OWN PAGE (7 Sept 2026): who is waiting on which litter. Nobody
# links to it and no search engine may list it; and it is never cached, so
# what he sees is what the counter holds right now. The API it talks to
# (/api/waitlist, a Pages Function) sets its own no-store header.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
